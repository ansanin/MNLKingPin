# SMTP email settings (example: Gmail app password, Brevo, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=KingPin <no-reply@example.com>

# Netlify authentication (set real values in Netlify, never commit them here)
KINGPIN_AUTH_SECRET=
KINGPIN_ADMIN_USERNAME=
KINGPIN_ADMIN_PASSWORD=
KINGPIN_ADMIN_EMAIL=

# Alternative email provider for Netlify Functions
RESEND_API_KEY=
RESEND_FROM_EMAIL=
